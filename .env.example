# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never prefix with NEXT_PUBLIC_ and never import into a client component.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional. Enables the seeded password sign-in form, development builds only.
# ENABLE_DEV_LOGIN=true

# Needed only by scripts/transcribe/. Server-side only, never NEXT_PUBLIC_.
OPENAI_API_KEY=

# Guest emails. Server-side only, never NEXT_PUBLIC_.
RESEND_API_KEY=
# The sender. Resend's test sender only delivers to your own account
# address; later this becomes an address on the church's domain, with
# no code change.
RESEND_FROM=GracePlace <onboarding@resend.dev>
# Where a guest's reply goes: the church's own mailbox. Required to send.
RESEND_REPLY_TO=

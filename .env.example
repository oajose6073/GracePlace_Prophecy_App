# =============================================================================
# GracePlace — environment variables
#
# Two Supabase projects, two local files, never mixed:
#
#   .env.local   dev project   qiwztvumbmrecjlbhrvn
#   .env.prod    production    nlanzwavfsocxijjvigf
#
# Both are in .gitignore (.env*.local, and .env.prod on its own line). The
# scripts in scripts/ read .env.local by default and .env.prod with --prod,
# and refuse to run if the file and the flag disagree about which project it
# is. Next.js never loads .env.prod, so `npm run build` and `npm run dev`
# always use .env.local.
#
# On Vercel, set the variables in sections 1 and 2 in the project settings.
# Section 3 stays on the computer that runs the scripts.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PUBLIC — inlined into the browser bundle at build time.
#    Safe to expose; changing one on Vercel needs a redeploy to take effect.
# -----------------------------------------------------------------------------

# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>

# Where sign-in links send people back to. Must be on the Supabase project's
# redirect allow-list. Production: https://words.graceplacewpg.ca
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. SERVER — needed on Vercel. Never prefix with NEXT_PUBLIC_, never import
#    into a client component.
# -----------------------------------------------------------------------------

# Supabase service-role key. Used by the sign-in allowlist check and the cron.
SUPABASE_SECRET_KEY=<secret key>

# Guest emails, sent from the review queue.
RESEND_API_KEY=<resend api key>
# The sender. Resend's test sender only delivers to your own account address;
# in production use an address on a domain verified in Resend.
RESEND_FROM=GracePlace Winnipeg <onboarding@resend.dev>
# The church's own mailbox. Guest replies go here, and /privacy shows it as the
# contact address. Required: sending refuses without it.
RESEND_REPLY_TO=<church gmail address>

# Protects /api/cron/guests-expire. Vercel sends it automatically as
# "Authorization: Bearer <value>" on every cron call. At least 16 characters;
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=<random string>


# -----------------------------------------------------------------------------
# 3. LOCAL ONLY — the scripts in scripts/. NOT needed on Vercel.
# -----------------------------------------------------------------------------

# Transcription. Only scripts/transcribe/ reads it; nothing deployed does.
OPENAI_API_KEY=<openai api key>

# Development only. Shows a password sign-in form for the seeded @example.com
# accounts. Has no effect in any production build, and is refused outright
# when pointed at the production project.
# ENABLE_DEV_LOGIN=true

# Optional. Overrides the ffmpeg binary that ffmpeg-static provides.
# FFMPEG_PATH=
